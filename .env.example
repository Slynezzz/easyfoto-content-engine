# Скопируй эти переменные в Railway → сервис → Variables

# Хранилище: подключи Volume с путём /data (в Dockerfile уже стоит DATA_DIR=/data)

# Нейросети (те же ключи, что у Easyfotobot)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Если ключи куплены у посредника (как у Easyfotobot) — его адреса, иначе не заполнять:
# GEMINI_BASE_URL=https://адрес-посредника
# OPENAI_BASE_URL=https://адрес-посредника/v1
# GEMINI_API_STYLE=auto   # auto | native (формат Google) | openai (формат OpenAI)
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1.5

# Поиск для разведки трендов. Достаточно одного варианта:
#   tavily     — поиск для AI-агентов, сам отдаёт текст страниц (бесплатно ~1000 запросов/мес)
#   serper     — выдача Google (2500 бесплатных запросов на старте)
#   brave      — выдача Brave Search
#   perplexity — модель Sonar, которая ищет сама и отвечает со ссылками (SEARCH_MODEL=sonar)
#   google_cse — Google Programmable Search (GOOGLE_API_KEY + GOOGLE_CSE_CX; API работает до 01.01.2027)
SEARCH_PROVIDER=
SEARCH_API_KEY=
# SEARCH_BASE_URL=   # если ключ куплен у посредника и у него свой адрес
# SEARCH_MODEL=sonar # только для perplexity
# TRENDS_WITHOUT_SEARCH=1  # без поиска всё равно предлагать идеи хуков (с пометкой)
# GOOGLE_API_KEY=
# GOOGLE_CSE_CX=

# Генерация новых кадров
# GENERATE_SHARE=0.7      # доля роликов из новых кадров в режиме mixed
# GENERATE_PHOTOS=4       # кадров на ролик (каждый тратит токены посредника)
# OCCASIONS_PER_DAY=1     # роликов к праздникам и инфоповодам в день
# Отдельный ключ только для картинок (например, AI STAR для gpt-image):
# IMAGE_API_BASE_URL=https://ai.starimg.ru/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1.5

# Откуда фото: library — твоя библиотека (бесплатно), mixed — библиотека + генерация, generate — только генерация
IMAGE_SOURCE=mixed
PERSONA_GENDER=male
BOT_USERNAME=Easyfotobot

# Админ-бот: НОВЫЙ бот от @BotFather (не токен Easyfotobot!)
ADMIN_BOT_TOKEN=
# chat_id бот пришлёт сам в ответ на любое сообщение, пока это поле пустое
ADMIN_CHAT_ID=

# Публичный адрес сервиса: Railway → Settings → Networking → Generate Domain
PUBLIC_BASE_URL=https://xxxx.up.railway.app

# Instagram (заполняется на этапе подключения публикации)
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v23.0

# Расписание (время аудитории)
TZ_NAME=Europe/Moscow
REELS_PER_DAY=2
PUBLISH_HOURS=12,19
PLAN_HOUR=8
EXPLORE_SHARE=0.3

# --- Музыка нейросетью под каждый ролик (ElevenLabs Music или посредник с тем же API)
# MUSIC_API_KEY=            # или ELEVENLABS_API_KEY — подойдёт любое из двух имён
# MUSIC_API_BASE_URL=https://api.elevenlabs.io
# MUSIC_MODEL=music_v1
# MAX_MUSIC_PER_DAY=4

# --- Воронка: база Easyfotobot только на чтение (в Railway можно сослаться на DATABASE_URL сервиса бота)
# BOT_DATABASE_URL=

# --- Модель для хуков и текстов роликов (у Gemini-посредника). Пусто — основная модель
# COPY_MODEL=claude-sonnet-5-5

# --- VK Клипы: приложение в кабинете VK ID (Web, redirect <PUBLIC_BASE_URL>/vk/callback) и номер сообщества; вход — /vk
# VK_APP_ID=
# VK_GROUP_ID=
# VK_SCOPE=video wall groups
# VK_CLIENT_SECRET=         # «Защищённый ключ» приложения — только если VK потребует
# VK_LINK_TARGET=max        # max — ссылка на бот в MAX, tg — в Telegram
# MAX_BOT_URL=https://max.ru/id230406400050_bot

# --- Предупреждать, когда на ключе посредника меньше N долларов
# BALANCE_WARN_USD=3

# --- YouTube Shorts: OAuth-клиент Google (Web application, redirect <PUBLIC_BASE_URL>/yt/callback); вход — /youtube
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_PRIVACY=public
